# {{ ansible_managed }}
# No secret here. The password comes from /etc/msmtp-password.
# See ADR-GEE3.
defaults
auth on
tls on
tls_starttls {{ 'on' if system_mail_tls_starttls else 'off' }}
tls_trust_file /etc/ssl/certs/ca-certificates.crt
syslog LOG_MAIL
aliases /etc/aliases

account default
host {{ system_mail_smarthost }}
port {{ system_mail_port }}
from {{ system_mail_from }}
user {{ system_mail_user }}
passwordeval cat /etc/msmtp-password
